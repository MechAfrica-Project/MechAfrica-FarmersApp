{
  "expo": {
    "name": "Farmers App",
    "slug": "mechafrica-farmers-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/mechafrica-square.png",
    "scheme": "farmers",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/481cec85-cb63-4658-8d4f-7d240a57ff67"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.mechafrica.farmer",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show your farm location on the map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mechafrica.farmer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mechafrica-square.png",
        "backgroundColor": "#FCFF3B"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/mechafrica.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "extraPrefs": {
              "org.gradle.jvmargs": "-Xmx3g -XX:MaxMetaspaceSize=512m"
            }
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFF3B",
          "image": "./assets/images/mechafrica.png",
          "dark": {
            "image": "./assets/images/mechafrica_dark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-font",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/mechafrica-square.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/custom_sound.wav"
          ],
          "android": {
            "channelId": "default"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "./plugins/withAdiRegistration.js",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "note": "Values (apiUrl, google maps keys) are injected at build-time from env via app.config.js.",
      "apiUrl": null,
      "apiBaseUrl": null,
      "eas": {
        "projectId": "481cec85-cb63-4658-8d4f-7d240a57ff67"
      }
    },
    "owner": "mechafrica"
  }
}
