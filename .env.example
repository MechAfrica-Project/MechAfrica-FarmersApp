# Copy this file to .env (do NOT commit secrets to Git)
# Placeholders and descriptions for environment variables used by the app


# Primary API base URL (simple canonical name)
API_URL=https://your-production-api-url.com

# Backwards-compatible names (Expo public names)
EXPO_PUBLIC_API_BASE_URL=https://your-production-api-url.com
EXPO_PUBLIC_API_URL=https://your-production-api-url.com

# Google Maps API keys (Expo expects public keys prefixed with EXPO_PUBLIC_ to be embedded in client builds)

# Google Maps API keys (canonical names)
GOOGLE_MAPS_IOS_API_KEY=your-ios-google-maps-api-key
GOOGLE_MAPS_ANDROID_API_KEY=your-android-google-maps-api-key

# Backwards-compatible Expo public names (optional)
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your-ios-google-maps-api-key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-google-maps-api-key

# Integration test options
# Optional: used by tests/integration/ping.integration.test.ts
INTEGRATION_PING_PATH=/health
RUN_INTEGRATION=false

# Node/Expo environment
NODE_ENV=development

# Example additional flags you may want to add later (placeholders)
# SENTRY_DSN=
# STRIPE_PUBLISHABLE_KEY=
# TWILIO_API_KEY=
# AWS_S3_BUCKET=
